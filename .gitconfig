[user]
        email = info@doany.io
        name = Ruk Doe
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[init]
        defaultBranch = main
[core]
        # Windows: パス長 260 文字制限を外す / コミット時に CRLF を LF にする
        longpaths = true
        autocrlf = input
# GitHub 以外の Git サーバーの認証。トークンは Infisical の /dotfiles/GIT_CREDENTIALS に
# 「https://<ユーザー>:<トークン>@<ホスト>」を 1 行ずつ置き、init.ps1 が ~/.git-credentials に書き出す
# 先頭の空の helper で、Git for Windows の既定 (C:/Program Files/Git/etc/gitconfig の manager) を外す。
# 外さないと manager も答えに加わり、認証に失敗したときに git が全部の helper に「消せ」と言うので、
# ~/.git-credentials の行まで消える (2026-10-07 に 2 回起きた。戻すには init.ps1 を流し直す)
[credential "https://fj.doany.io"]
        helper =
        helper = store --file ~/.git-credentials
[credential "https://code.ffmpeg.org"]
        helper =
        helper = store --file ~/.git-credentials